{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-opportunity-discovery",
  "main": "api-worker.js",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
